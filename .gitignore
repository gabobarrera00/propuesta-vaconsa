# build.js output (regenerated by `node build.js` / `npm run build`) —
# not pages/inicio.html, the source; just the generated root index.html
# and the per-section output folders it writes via outputPath()
#
# NOTE: this list is explicit, not a wildcard — build.js's outputPath()
# derives each folder name from whatever files exist under pages/*.html,
# so adding a new page there means adding its matching /{name}/ line
# here too, or the generated output gets committed by accident.
/index.html
/catalogo/
/cotizar/
/desarrolladores/
/donde-estamos/
/fichas-tecnicas/
/nosotros/
/portal-clientes/
/respaldo-tecnico/
/responsabilidad/
/servicios/

# leftover from local `python -m http.server` verification runs
server.log
